# Copy to .env.local and fill in after deploying program/lib.rs in Solana Playground.
# Leave empty to run the game with on-chain features disabled (fallback mode).
NEXT_PUBLIC_PROGRAM_ID=
# Optional: a custom Devnet RPC URL (must contain "devnet" for mobile wallet adapter cluster detection)
NEXT_PUBLIC_RPC_URL=

# Only used by scripts/generate-voices.mjs to record voice lines once. The game itself needs no key.
ELEVENLABS_API_KEY=
